{
  "rules": {
    "notifications": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$notificationId": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['kind', 'action', 'actorId', 'actorName', 'transactionId', 'type', 'amount', 'category', 'walletName', 'at'])",
        "kind": {
          ".validate": "newData.val() === 'finance'"
        },
        "action": {
          ".validate": "newData.val() === 'added' || newData.val() === 'updated' || newData.val() === 'deleted'"
        },
        "actorId": {
          ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length <= 128"
        },
        "actorName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "transactionId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "type": {
          ".validate": "newData.val() === 'income' || newData.val() === 'expense'"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "categoryLabel": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "walletName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
